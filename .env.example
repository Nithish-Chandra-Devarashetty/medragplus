# Copy to .env and adjust. Every value has a sensible default (see backend/config/settings.py).

# --- server ---------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173
MAX_AUDIO_MB=10
PRELOAD_MODELS=true            # load all models at startup instead of on the first request

# --- MongoDB (users, sessions, messages, safety_flags) -----------------------
# docker compose up -d mongo   ->  mongodb://localhost:27017
# mongomock://                 ->  in-memory, lost on restart (no install needed)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=medrag_plus

# --- Qdrant -----------------------------------------------------------------
# Leave QDRANT_URL empty to use embedded on-disk Qdrant at QDRANT_PATH (single process only).
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=medical_knowledge

# --- Embeddings (PubMedBERT, 768-d) -------------------------------------------
EMBEDDING_BACKEND=pubmedbert   # pubmedbert | fake
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIM=768

# --- Ingestion ------------------------------------------------------------------
DOCUMENTS_DIR=data/medical_documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval / conversation ------------------------------------------------------
TOP_K=3
MIN_RETRIEVAL_SCORE=0.35       # chunks below this cosine score are discarded
HISTORY_TURNS=3
CONDENSE_MODE=concat           # concat (fast) | llm (LangChain-style standalone question; +1 LLM call)

# --- BioMistral-7B via llama.cpp ---------------------------------------------------
LLM_BACKEND=llamacpp           # llamacpp | fake
LLM_MODEL_PATH=models/BioMistral-7B.Q4_K_M.gguf
LLM_N_CTX=4096
LLM_N_THREADS=8                # physical cores; 0 = llama.cpp default
LLM_N_BATCH=512
LLM_MAX_TOKENS=200
LLM_CONTEXT_CHARS_PER_CHUNK=700  # prompt size dominates CPU latency
LLM_TEMPERATURE=0.0            # greedy = reproducible

# --- Languages --------------------------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,te
TRANSLATION_BACKEND=nllb       # nllb | identity | fake
NLLB_MODEL=facebook/nllb-200-distilled-600M

# --- Speech -----------------------------------------------------------------------
ASR_BACKEND=faster_whisper     # faster_whisper | fake | none
WHISPER_MODEL=large-v3-turbo   # 'small' is ~10x faster but produces gibberish for Telugu
ASR_MIN_AVG_LOGPROB=-1.0       # reject unclear recordings instead of answering a garbled transcript
WHISPER_COMPUTE_TYPE=int8
TTS_BACKEND=gtts               # gtts (needs internet) | fake | none

# --- Safety layer -------------------------------------------------------------------
# Thresholds are engineering defaults, NOT clinically validated. Tune on eval data.
CONFIDENCE_THRESHOLD=0.70
CONFIDENCE_WEIGHT_RETRIEVAL=0.3
CONFIDENCE_WEIGHT_GENERATION=0.3
CONFIDENCE_WEIGHT_GROUNDING=0.4
RETRIEVAL_SCORE_FLOOR=0.35
RETRIEVAL_SCORE_CEILING=0.85
HALLUCINATION_BACKEND=nli      # nli | lexical
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
ENTAILMENT_THRESHOLD=0.5
NLI_WINDOW_SENTENCES=2         # claims are checked against N-sentence spans of each chunk
LEXICAL_SUPPORT_THRESHOLD=0.5
MAX_UNSUPPORTED_RATIO_FOR_REWRITE=0.34
EMERGENCY_NEGATION=true
RED_FLAGS_PATH=backend/config/red_flags.yaml
TRIAGE_RULES_PATH=backend/config/triage_rules.yaml
MESSAGES_PATH=backend/config/messages.yaml
